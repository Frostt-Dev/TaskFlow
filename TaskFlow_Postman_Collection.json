	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Dynamic Future Date generator for valid test requests",
					"const now = new Date();",
					"const future = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 3);",
					"pm.globals.set('futureDate', future.toISOString());"
				]
			}
		}
